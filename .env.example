# Gmail account used to SEND the enquiry (needs a Google App Password, not your normal password)
GMAIL_USER=your-workshop@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# Address that receives enquiries. Defaults to latinkingdetailing@outlook.com if omitted.
CONTACT_EMAIL_TO=latinkingdetailing@outlook.com

# Google Tag Manager Container ID
NEXT_PUBLIC_GTM_ID=GTM-WHHK468T

# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Microsoft Clarity Project ID
NEXT_PUBLIC_CLARITY_PROJECT_ID=XXXXXXXXXX
